#: background.cpp:40
msgid "E&nable background"
msgstr "পটভূমি প্রদর্শন সক্রিয় করুন (&n)"

#: background.cpp:42
msgid ""
"If this is checked, KDM will use the settings below for the background. If "
"it is disabled, you have to look after the background yourself. This is done "
"by running some program (possibly xsetroot) in the script specified in the "
"Setup= option in kdmrc (usually Xsetup)."
msgstr ""

#: kdm-conv.cpp:49
msgid "<big><b><center>Attention<br/>Read help</center></b></big>"
msgstr ""

#: kdm-conv.cpp:59
msgid "Enable Au&to-Login"
msgstr "স্বয়ংক্রিয় লগ-ইন সক্রিয় করুন (&t)"

#: kdm-conv.cpp:65
msgid ""
"Turn on the auto-login feature. This applies only to KDM's graphical login. "
"Think twice before enabling this!"
msgstr ""
"স্বয়ংক্রিয় লগ-ইনের বৈশিষ্ট্য সক্রিয় করুন। শুধুমাত্র KDM-র গ্রাফিক্যাল লগ-ইনের ক্ষেত্রে "
"প্রযোজ্য। এটি সক্রিয় করার পূর্বে পুনরায় বিবেচনা করা বাঞ্ছনীয়।"

#: kdm-conv.cpp:72
msgid "Use&r:"
msgstr "ব্যবহারকারী: (&r)"

#: kdm-conv.cpp:81
msgid "Select the user to be logged in automatically."
msgstr "স্বয়ংক্রিয়রূপে লগ-ইনের জন্য চিহ্নিত ব্যবহারকারীর নাম নির্বাচন করুন।"

#: kdm-conv.cpp:84
msgid "Loc&k session"
msgstr "সেশান লক করুন: (&k)"

#: kdm-conv.cpp:88
msgid ""
"The automatically started session will be locked immediately (provided it is "
"a KDE session). This can be used to obtain a super-fast login restricted to "
"one user."
msgstr ""

#: kdm-conv.cpp:92
msgctxt "@title:group"
msgid "Preselect User"
msgstr "ব্যবহারকারীর নাম পূর্বে নির্বাচন করুন"

#: kdm-conv.cpp:96
msgctxt "@option:radio preselected user"
msgid "&None"
msgstr "শূণ্য (&N)"

#: kdm-conv.cpp:97
msgctxt "@option:radio preselected user"
msgid "Prev&ious"
msgstr "পূর্ববর্তী (&i)"

#: kdm-conv.cpp:99
msgid ""
"Preselect the user that logged in previously. Use this if this computer is "
"usually used several consecutive times by one user."
msgstr ""

#: kdm-conv.cpp:101
msgctxt "@option:radio preselected user"
msgid "Specif&y"
msgstr "নির্ধারণ করুন (&y)"

#: kdm-conv.cpp:103
msgid ""
"Preselect the user specified in the combo box below. Use this if this "
"computer is predominantly used by a certain user."
msgstr ""

#: kdm-conv.cpp:118
msgid "Us&er:"
msgstr "ব্যবহারকারী: (&e)"

#: kdm-conv.cpp:122
msgid ""
"Select the user to be preselected for login. This box is editable, so you "
"can specify an arbitrary non-existent user to mislead possible attackers."
msgstr ""

#: kdm-conv.cpp:135
msgctxt "@option:check action"
msgid "Focus pass&word"
msgstr "পাসওয়ার্ডের উপর ফোকাস করা হবে (&w)"

#: kdm-conv.cpp:138
msgid ""
"When this option is on, KDM will place the cursor in the password field "
"instead of the user field after preselecting a user. Use this to save one "
"key press per login, if the preselection usually does not need to be changed."
msgstr ""

#: kdm-conv.cpp:144
msgid "Enable Password-&Less Logins"
msgstr "পাসওয়ার্ড বিহীন লগ-ইন সক্রিয় করা হবে (&L)"

#: kdm-conv.cpp:151
msgid ""
"When this option is checked, the checked users from the list below will be "
"allowed to log in without entering their password. This applies only to "
"KDM's graphical login. Think twice before enabling this!"
msgstr ""

#: kdm-conv.cpp:158
msgid "No password re&quired for:"
msgstr "প্রদর্শিত ব্যবহারকারীদের জন্য পাসওয়ার্ড প্রয়োজন নেই: (&q)"

#: kdm-conv.cpp:164
msgid ""
"Check all users you want to allow a password-less login for. Entries denoted "
"with '@' are user groups. Checking a group is like checking all users in "
"that group."
msgstr ""

#: kdm-conv.cpp:168 kdm-shut.cpp:93
msgctxt "@title:group"
msgid "Miscellaneous"
msgstr "বিবিধ"

#: kdm-conv.cpp:172
msgid "Automatically log in again after &X server crash"
msgstr "X-সার্ভার বিপর্যয়ের পরে স্বয়ংক্রিয়ভাবে পুনরায় লগ-ইন হবে (&X)"

#: kdm-conv.cpp:174
msgid ""
"When this option is on, a user will be logged in again automatically when "
"their session is interrupted by an X server crash; note that this can open a "
"security hole: if you use a screen locker than KDE's integrated one, this "
"will make circumventing a password-secured screen lock possible."
msgstr ""

#: kdm-dlg.cpp:66
msgid "&Greeting:"
msgstr "অভিবাদন: (&G)"

#: kdm-dlg.cpp:73
msgid ""
"<p>This is the \"headline\" for KDM's login window. You may want to put some "
"nice greeting or information about the operating system here.</p><p>KDM will "
"substitute the following character pairs with the respective contents:</"
"p><ul><li>%d -> current display</li><li>%h -> host name, possibly with "
"domain name</li><li>%n -> node name, most probably the host name without "
"domain name</li><li>%s -> the operating system</li><li>%r -> the operating "
"system's version</li><li>%m -> the machine (hardware) type</li><li>%% -> a "
"single %</li></ul>"
msgstr ""

#: kdm-dlg.cpp:94
msgid "Logo area:"
msgstr "লোগো প্রদর্শনের স্থান:"

#: kdm-dlg.cpp:99
msgctxt "logo area"
msgid "&None"
msgstr "শূণ্য (&N)"

#: kdm-dlg.cpp:100
msgid "Show cloc&k"
msgstr "ঘড়ি প্রদর্শন করা হবে (&k)"

#: kdm-dlg.cpp:101
msgid "Sho&w logo"
msgstr "লোগো প্রদর্শিত হবে (&w)"

#: kdm-dlg.cpp:112
msgid ""
"You can choose to display a custom logo (see below), a clock or no logo at "
"all."
msgstr "স্বনির্ধারিত লোগো (নীচে দেখুন), একটি ঘড়ি অথবা লোগোবিনা প্রদর্শন করা যাবে।"

#: kdm-dlg.cpp:118
msgid "&Logo:"
msgstr "লোগো: (&L)"

#: kdm-dlg.cpp:129
msgid ""
"Click here to choose an image that KDM will display. You can also drag and "
"drop an image onto this button (e.g. from Konqueror)."
msgstr ""
"KDM দ্বারা প্রদর্শনের উদ্দেশ্যে একটি ছবি এইখানে ক্লিক করুন। বিকল্প হিসাবে, এই বাটনের "
"মধ্যে কোনো ছবি টেনে নিয়ে এসে ফেলা যাবে (উদাহরণস্বরূপ, Konqueror থেকে)।"

#: kdm-dlg.cpp:140
msgid "Dialog &position:"
msgstr "ডায়লগের স্থান: (&p)"

#: kdm-dlg.cpp:249
#, kde-format
msgid ""
"There was an error loading the image:\n"
"%1\n"
"It will not be saved."
msgstr ""
"ছবি লোড করতে সমস্যা:\n"
"%1\n"
"এটি সংরক্ষণ করা হবে না।"

#: kdm-dlg.cpp:284 kdm-dlg.cpp:312
#, c-format
msgid "Welcome to %s at %n"
msgstr "%s-এ স্বাগতম %n-র মধ্যে"

#: kdm-dlg.cpp:322
msgid ""
"<h1>KDM - Dialog</h1> Here you can configure the basic appearance of the KDM "
"login manager in dialog mode, i.e. a greeting string, an icon etc."
msgstr ""
"<h1>KDM - ডায়লগ</h1> ডায়লগ মোডে প্রদর্শিত KDM লগ-ইন পরিচালনব্যবস্থার মৌলিক "
"চেহারাছবি এইখানে কনফিগার করা যাবে, অর্থাৎ অভিবাদন, আইকন প্রভৃতি"

#: kdm-gen.cpp:49
msgctxt "@title:group 'man locale' ..."
msgid "Locale"
msgstr "লোকেইল"

#: kdm-gen.cpp:60
msgid "&Language:"
msgstr "ভাষা: (&L)"

#: kdm-gen.cpp:62
msgid ""
"Here you can choose the language used by KDM. This setting does not affect a "
"user's personal settings; that will take effect after login."
msgstr ""
"KDM দ্বারা ব্যবহারযোগ্য ভাষা এইখানে নির্বাচন করা যাবে। এর ফলে ব্যবহারকারী দ্বারা "
"নিজের ব্যক্তিগত প্রয়োগের জন্য বাছাই করা বৈশিষ্ট্য পরিবর্তিত হবে না; লগ-ইনের পরে এই "
"পরিবর্তনগুলি প্রয়োগ করা হবে।"

#: kdm-gen.cpp:71
msgctxt "@title:group"
msgid "Appearance"
msgstr "চেহারাছবি"

#: kdm-gen.cpp:78
msgid "&Use themed greeter"
msgstr "থিমসহ অভিবাদন পদ্ধতি ব্যবহার করা হবে (&U)"

#: kdm-gen.cpp:81
msgid "Enable this if you would like to use a themed Login Manager."
msgstr "থিম সহ লগ-ইন পরিচালনব্যবস্থা ব্যবহার করতে ইচ্ছুক হলে, এই বৈশিষ্ট্য সক্রিয় করুন।"

#: kdm-gen.cpp:85 kdm-gen.cpp:96 kdm-users.cpp:99
msgid "<placeholder>default</placeholder>"
msgstr "<placeholder>ডিফল্ট মান</placeholder>"

#: kdm-gen.cpp:90
msgid "GUI s&tyle:"
msgstr "GUI-র বিন্যাস: (&t)"

#: kdm-gen.cpp:92
msgid "You can choose a basic GUI style here that will be used by KDM only."
msgstr "শুধুমাত্র KDM দ্বারা ব্যবহারযোগ্য একটি সাদামাটা GUI বিন্যাস নির্বাচন করুন।"

#: kdm-gen.cpp:100
msgid "Color sche&me:"
msgstr ""

#: kdm-gen.cpp:102
msgid "You can choose a basic Color Scheme here that will be used by KDM only."
msgstr ""

#: kdm-gen.cpp:105
msgctxt "@title:group"
msgid "Fonts"
msgstr "ফন্ট"

#: kdm-gen.cpp:113
msgid ""
"This changes the font which is used for all the text in the login manager "
"except for the greeting and failure messages."
msgstr ""
"এর ফলে অভিবাদন ও বিফলতার বার্তা ব্যতীত লগ-ইন পর্দায় অন্যান্য টেক্সট প্রদর্শনের জন্য "
"ব্যবহৃত ফন্ট পরিবর্তিত হবে"

#: kdm-gen.cpp:116
msgctxt "... font"
msgid "&General:"
msgstr "সাধারণ: (&G)"

#: kdm-gen.cpp:120
msgid ""
"This changes the font which is used for failure messages in the login "
"manager."
msgstr ""
"লগ-ইন পরিচালন ব্যবস্থার মধ্যে বিফলতা সংক্রান্ত বার্তা প্রদর্শনের জন্য ব্যবহৃত ফন্ট এর "
"ফলে পরিবর্তন করা হয়।"

#: kdm-gen.cpp:122
msgctxt "font for ..."
msgid "&Failure:"
msgstr "ব্যর্থতা: (&F)"

#: kdm-gen.cpp:126
msgid "This changes the font which is used for the login manager's greeting."
msgstr ""
"লগ-ইন পরিচালন ব্যবস্থার অভিবাদন বার্তার জন্য ব্যবহৃত ফন্ট এর ফলে পরিবর্তন করা হবে।"

#: kdm-gen.cpp:128
msgctxt "font for ..."
msgid "Gree&ting:"
msgstr "অভিবাদন: (&t)"

#: kdm-gen.cpp:130
msgid "Use anti-aliasing for fonts"
msgstr "ফন্টের জন্য অ্যান্ট-অ্যালায়েসিং ব্যবহার করা হবে"

#: kdm-gen.cpp:132
msgid ""
"If you check this box and your X-Server has the Xft extension, fonts will be "
"antialiased (smoothed) in the login dialog."
msgstr ""
"এই বক্স নির্বাচন করা হলে ও ব্যবহৃত X-Server-র জন্য Xft এক্সটেনশন উপস্থিত থাকলে, লগ-"
"ইন ডায়ল বক্সের মধ্যে প্রয়োগ হওয়া ফন্টগুলি অ্যান্টি-অ্যালায়েস (অর্থাৎ মসৃণ) করা হবে।"

#: kdm-shut.cpp:43
msgid "Allow Shutdown"
msgstr "বন্ধ করার অনুমতিপ্রাপ্ত"

#: kdm-shut.cpp:47
msgctxt "shutdown request origin"
msgid "&Local:"
msgstr "স্থানীয়: (&L)"

#: kdm-shut.cpp:49 kdm-shut.cpp:57
msgctxt "@item:inlistbox allow shutdown"
msgid "Everybody"
msgstr "সকল"

#: kdm-shut.cpp:50 kdm-shut.cpp:58
msgctxt "@item:inlistbox allow shutdown"
msgid "Only Root"
msgstr "শুধুমাত্র Root"

#: kdm-shut.cpp:51 kdm-shut.cpp:59
msgctxt "@item:inlistbox allow shutdown"
msgid "Nobody"
msgstr "কেউ না"

#: kdm-shut.cpp:55
msgctxt "shutdown request origin"
msgid "&Remote:"
msgstr "দূরবর্তী: (&R)"

#: kdm-shut.cpp:62
msgid ""
"Here you can select who is allowed to shutdown the computer using KDM. You "
"can specify different values for local (console) and remote displays. "
"Possible values are:<ul> <li><em>Everybody:</em> everybody can shutdown the "
"computer using KDM</li> <li><em>Only root:</em> KDM will only allow shutdown "
"after the user has entered the root password</li> <li><em>Nobody:</em> "
"nobody can shutdown the computer using KDM</li></ul>"
msgstr ""

#: kdm-shut.cpp:72
msgctxt "@title:group shell commands for shutdown"
msgid "Commands"
msgstr "কমান্ড"

#: kdm-shut.cpp:75
msgctxt "command for ..."
msgid "H&alt:"
msgstr "স্থগিত করুন: (&a)"

#: kdm-shut.cpp:79
msgid "Command to initiate the system halt. Typical value: /sbin/halt"
msgstr "সিস্টেমে কর্ম স্থগিত করতে ব্যবহৃত কমান্ড। সাধারণত: /sbin/halt"

#: kdm-shut.cpp:84
msgctxt "command for ..."
msgid "Reb&oot:"
msgstr "পুনরায় বুট: (&o)"

#: kdm-shut.cpp:88
msgid "Command to initiate the system reboot. Typical value: /sbin/reboot"
msgstr "সিস্টেম পুনরায় বুট করার জন্য ব্যবহৃত কমান্ড। সাধারণত: /sbin/reboot"

#: kdm-shut.cpp:96
msgctxt "boot manager"
msgid "None"
msgstr "শূণ্য"

#: kdm-shut.cpp:97
msgid "Grub"
msgstr "Grub"

#: kdm-shut.cpp:99
msgid "Lilo"
msgstr "Lilo"

#: kdm-shut.cpp:101
msgid "Boot manager:"
msgstr "বুট পরিচালন ব্যবস্থা:"

#: kdm-shut.cpp:104
msgid "Enable boot options in the \"Shutdown...\" dialog."
msgstr ""

#: kdm-theme.cpp:75
msgctxt "@title:column"
msgid "Theme"
msgstr "থিম"

#: kdm-theme.cpp:76
msgctxt "@title:column"
msgid "Author"
msgstr "নির্মাতা"

#: kdm-theme.cpp:80
msgid ""
"This is a list of installed themes.\n"
"Click the one to be used."
msgstr ""
"ইনস্টল হওয়া থিমের তালিকা।\n"
"ব্যবহারের জন্য যে কোনো একটি ক্লিক করুন।"

#: kdm-theme.cpp:88
msgid "This is a screen shot of what KDM will look like."
msgstr ""

#: kdm-theme.cpp:96
msgid "This contains information about the selected theme."
msgstr "নির্বাচিত থিম সম্পর্কিত তথ্য এর মধ্যে অন্তর্ভুক্ত রয়েছে।"

#: kdm-theme.cpp:100
msgctxt "@action:button"
msgid "Install &new theme"
msgstr "নতুন থিম ইনস্টল করুন (&n)"

#: kdm-theme.cpp:101
msgid "This will install a theme into the theme directory."
msgstr "এর ফলে, থিম ডিরেক্টরির মধ্যে একটি থিম ইনস্টল করা হবে।"

#: kdm-theme.cpp:105
msgctxt "@action:button"
msgid "&Remove theme"
msgstr "থিম মুছে ফেলুন (&R)"

#: kdm-theme.cpp:106
msgid "This will remove the selected theme."
msgstr "এর ফলে নির্বাচিত থিম মুছে ফেলা হবে।"

#: kdm-theme.cpp:110
msgctxt "@action:button"
msgid "&Get New Themes"
msgstr "নতুন থিম প্রাপ্ত করুন (&G)"

#: kdm-theme.cpp:123 kdm-users.cpp:93
#, kde-format
msgid "Unable to create folder %1"
msgstr "ফোল্ডার %1 নির্মাণ করতে ব্যর্থ"

#: kdm-theme.cpp:205
#, kde-format
msgid "<qt><strong>Copyright:</strong> %1<br/></qt>"
msgstr "<qt><strong>স্বত্বাধিকার:</strong> %1<br/></qt>"

#: kdm-theme.cpp:208
#, kde-format
msgid "<qt><strong>Description:</strong> %1</qt>"
msgstr "<qt><strong>বিবরণ:</strong> %1</qt>"

#: kdm-theme.cpp:220
msgid "Drag or Type Theme URL"
msgstr "থিমের URL টেনে আনুন অথবা লিখুন।"

#: kdm-theme.cpp:239
#, kde-format
msgid "Unable to find the KDM theme archive %1."
msgstr "KDM থিম আর্কাইভ %1 সন্ধান করতে ব্যর্থ।"

#: kdm-theme.cpp:241
#, kde-format
msgid ""
"Unable to download the KDM theme archive;\n"
"please check that address %1 is correct."
msgstr ""
"KDM থিম আর্কাইভ ডাউনলোড করতে ব্যর্থ;\n"
"অনুগ্রহ করে পরীক্ষা করুন %1 ঠিকানাটি সঠিক কি না।"

