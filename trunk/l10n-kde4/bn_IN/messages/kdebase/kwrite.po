#: kwritemain.cpp:71 kwritemain.cpp:481
msgid ""
"A KDE text-editor component could not be found;\n"
"please check your KDE installation."
msgstr ""
"KDE টেক্সট এডিটারের একটি কম্পোনেন্ট পাওয়া যায়নি;\n"
"অনুগ্রহ করে অাপনার KDE ইনস্টলেশন পরীক্ষা করুন।"

#: kwritemain.cpp:147
msgid "Use this to close the current document"
msgstr "এটা বর্তমান ডকুমেন্ট বন্ধ করার জন্যে ব্যবহার করুন"

#: kwritemain.cpp:151
msgid "Use this command to create a new document"
msgstr "এই কমান্ড নতুন ডকুমেন্ট খোলার জন্যে ব্যবহার করুন"

#: kwritemain.cpp:153
msgid "Use this command to open an existing document for editing"
msgstr "এই কমান্ড দিয়ে একটি সংরক্ষিত ডকুমেন্ট সম্পাদনার জন্যে খুলুন"

#: kwritemain.cpp:157
msgid ""
"This lists files which you have opened recently, and allows you to easily "
"open them again."
msgstr ""
"এটা অাপনার সম্প্রতি খোলা ফাইলগুলোর সূচী নির্মাণ করে এবং এগুলো সহজেই অাপনি অাবার "
"খুলতে পারেন।"

#: kwritemain.cpp:161
msgid "&New Window"
msgstr "নতুন উইন্ডো(&N)"

#: kwritemain.cpp:163
msgid "Create another view containing the current document"
msgstr "বর্তমান ডকুমেন্টের জন্য নতুন প্রদর্শন বিন্যাস নির্মাণ করুন"

#: kwritemain.cpp:166
msgid "Close the current document view"
msgstr "বর্তমান ডকুমেন্টের প্রদর্শন বন্ধ করুন"

#: kwritemain.cpp:173
msgid "Use this command to show or hide the view's statusbar"
msgstr ""
"এই কমান্ড প্রদর্শিত ক্ষেত্রের স্ট্যাটাস‌-বার প্রদর্শন বা গোপন করার জন্যে ব্যবহার করুন"

#: kwritemain.cpp:175
msgid "Sho&w Path"
msgstr "পথ প্রদর্শন করা হবে (&w)"

#: kwritemain.cpp:178
msgid "Show the complete document path in the window caption"
msgstr "উইন্ডো শিরোনামে ডকুমেন্টের সম্পূর্ণ পথ প্রদর্শন করা হবে"

#: kwritemain.cpp:181
msgid "Configure the application's keyboard shortcut assignments."
msgstr "অ্যাপ্লিকেশনের কিবোর্ড-র্শটকাট অ্যাসাইনমেন্ট গুলো কনফিগর করুন"

#: kwritemain.cpp:185
msgid "Configure which items should appear in the toolbar(s)."
msgstr "কোন বস্তুসমূহ টুলবারে প্রদর্শিত হবে তা কনফিগর করুন"

#: kwritemain.cpp:188
msgid "&About Editor Component"
msgstr "এডিটার কম্পোনেন্টের পরিচিতি (&A)"

