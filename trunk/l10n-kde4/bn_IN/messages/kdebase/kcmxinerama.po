#: kcmxinerama.cpp:60
msgid "George Staikos"
msgstr "জর্জ স্টাইকোস"

#: kcmxinerama.cpp:63
msgid ""
"<h1>Multiple Monitors</h1> This module allows you to configure KDE support "
"for multiple monitors."
msgstr "<h1>একাধিক মনিটর</h1> এই মডিউলের সাহায্যে KDE-র মধ্যে একাধিক মনিটরের ব্যবহার কনফিগারে করা সম্ভব হবে।"

#: kcmxinerama.cpp:87
#, kde-format
msgid "Display %1"
msgstr "প্রদর্শন %1"

#: kcmxinerama.cpp:97
msgid "Display Containing the Pointer"
msgstr "পয়েন্টার ধারণকারী প্রদর্শন"

#: kcmxinerama.cpp:108
msgid ""
"<qt><p>This module is only for configuring systems with a single desktop "
"spread across multiple monitors. You do not appear to have this "
"configuration.</p></qt>"
msgstr ""

#: kcmxinerama.cpp:171
msgid "Some settings may affect only newly started applications."
msgstr "কিছু বৈশিষ্ট্যের মান, শুধুমাত্র নতুন আরম্ভ করা অ্যাপ্লিকেশনগুলিকে প্রভাবিত করবে।"

#: kcmxinerama.cpp:171
msgid "KDE Multiple Monitors"
msgstr "KDE-র একাধিক মনিটর"

