#: main.cpp:102
msgid ""
"<qt>Here you can change your personal information, which will be used in "
"mail programs and word processors, for example. You can change your login "
"password by clicking <em>Change Password</em>.</qt>"
msgstr "<qt>এখানে আপনি আপনার নিজস্ব পরিচিতি পরিবর্তন করতে পারবেন যা বিভিন্ন ধরনের অ্যাপ্লিকেশন যেমন মেল প্রোগ্রাম এবং ওয়ার্ড প্রোসেসর-এ ব্যবহৃত হবে। ক্লিক করে আপনি আপনার লগইন পাসওয়ার্ড পরিবর্তন করতে পারবেন <em>পাসওয়ার্ড পরিবর্তন</em>।</qt>"

#: main.cpp:116
msgid ""
"A program error occurred: the internal program 'kdepasswd' could not be "
"found. You will not be able to change your password."
msgstr "প্রোগ্রাম চলানো যাচ্ছে না: প্রোগ্রামের অন্তরের 'kdepasswd' পাওয়া যায়নি। আপনি আপনার পাসওয়ার্ড পরিবর্তন করতে পারবেন না।"

#: main.cpp:215
msgid "Please enter your password in order to save your settings:"
msgstr "আপনার নির্বাচিত বৈশিষ্ট্যগুলি সংরক্ষণ করার জন্য অনুগ্রহ করে আপনার পাসওয়ার্ড লিখুন:"

#: main.cpp:218
msgid "You must enter your password in order to change your information."
msgstr "আপনার পরিচিতি পরিবর্তন করার জন্য আপনাকে পাসওয়ার্ড দিতে হবে।"

#: main.cpp:228
msgid "You must enter a correct password."
msgstr "আপনার সঠিক পাসওয়ার্ড লেখা আবশ্যক হবে।"

#: main.cpp:232
#, kde-format
msgid ""
"An error occurred and your password has probably not been changed. The error "
"message was:\n"
"%1"
msgstr ""
"একটি ত্রুটি উৎপন্ন হয়েছে এবং আপনার পাসওয়ার্ড সম্ভবত পরিবর্তীত হয়নি। সংশ্লিষ্ট ত্রুটি সংক্রান্ত বার্তা:\n"
"%1"

#: main.cpp:246
#, kde-format
msgid "There was an error saving the image: %1"
msgstr "ছবি সংরক্ষণ করা যাচ্ছে না: %1"

#: main.cpp:272 main.cpp:306
msgid "Your administrator has disallowed changing your image."
msgstr "আপনার অ্যাডমিনিসট্রেটর আপনাকে ছবি পরিবর্তনের প্রয়োজনীয় অনুমতি প্রদান করেননি।"

#: main.cpp:339
#, kde-format
msgid ""
"%1 does not appear to be an image file.\n"
"Please use files with these extensions:\n"
"%2"
msgstr ""
"%1এটি ছবির ফাইল নয়।\n"
"অনুগ্রহ করে চিহ্নিত এক্সটেনশনগুলি সহ ফাইল ব্যবহার করুন:\n"
"%2"

