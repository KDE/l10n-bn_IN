#: random.cpp:45
#, kde-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"ব্যবহারপ্রণালী: %1 [-setup] [args]\n"
"যথেচ্ছরূপে একটি স্ক্রিন-সেভার নির্বাচন করে আরম্ভ করা হয়।\n"
"আর্গুমেন্টগুলি (-setup ভিন্ন) স্ক্রিন-সেভারকে পাঠানো হয়।"

#: random.cpp:52
msgid "Start a random KDE screen saver"
msgstr "যথেচ্ছরূপে একটি KDE স্ক্রিন-সেভার নির্বাচন করে আরম্ভ করা হবে"

#: random.cpp:67
msgid "Random screen saver"
msgstr "যথেচ্ছরূপে নির্বাচিত একটি স্ক্রিন-সেভার"

#: random.cpp:73
msgid "Setup screen saver"
msgstr "স্ক্রিন-সেভার প্রস্তুতি"

#: random.cpp:75
msgid "Run in the specified XWindow"
msgstr "সুনির্দিষ্ট XWindow-র মধ্যে সঞ্চালন করা হবে"

#: random.cpp:77
msgid "Run in the root XWindow"
msgstr "root XWindow-র মধ্যে সঞ্চালন করা হবে"

#: random.cpp:201
msgid "Setup Random Screen Saver"
msgstr "যথেচ্ছরূপে নির্বাচিত স্ক্রিন-সেভার প্রস্তুতি"

#: random.cpp:210
msgid "Use OpenGL screen savers"
msgstr "OpenGL স্ক্রিন-সেভার ব্যবহার করা হবে"

#: random.cpp:213
msgid "Use screen savers that manipulate the screen"
msgstr "পর্দা নিয়ন্ত্রণ করতে ব্যবহৃত স্ক্রিন-সেভার প্রয়োগ করা হবে"
