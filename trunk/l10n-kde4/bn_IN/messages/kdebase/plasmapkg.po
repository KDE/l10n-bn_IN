#: main.cpp:36
msgid "Install, list, remove Plasma packages"
msgstr "Plasma প্যাকেজগুলি ইনস্টল, তালিকাভুক্ত, অপসারণ করুন"

#: main.cpp:47
msgid "Plasma Package Manager"
msgstr "Plasma প্যাকেজ পরিচালনব্যবস্থা"

#: main.cpp:49
msgid "(C) 2008, Aaron Seigo"
msgstr "(C) ২০০৮ অ্যারন সেইগো"

#: main.cpp:50
msgid "Aaron Seigo"
msgstr "অ্যারন সেইগো"

#: main.cpp:51
msgid "Original author"
msgstr "মূল লেখক"

#: main.cpp:60
msgid "For install or remove, operates on packages installed for all users."
msgstr "ইনস্টল বা অপসারণের ক্ষেত্রে, সকল ব্যবহারকারীর জন্য ইনস্টল করা প্যাকেজগুলি প্রভাবিত হবে।"

#: main.cpp:63
msgid ""
"The type of package, e.g. theme, wallpaper, plasmoid, DataEngine, Runner, "
"etc."
msgstr "প্যাকেজের ধরন, যেমন থিম, ওয়াল-পেপার, plasmoid (প্লাসময়েড), DataEngine (ডাটা-ইঞ্জিন), Runner (রানার), ইত্যাদি।"

#: main.cpp:67
msgid "Install the package at <path>"
msgstr "প্যাকেজটি <path>-এ ইনস্টল করুন"

#: main.cpp:69
msgid "List installed packages"
msgstr "ইনস্টল হওয়া প্যাকেজগুলি তালিকাভুক্ত করুন"

#: main.cpp:71
msgid "Remove the package named <name>"
msgstr "<name> নামক প্যাকেজটি অপসারণ করুন"

#: main.cpp:73
msgid ""
"Absolute path to the package root. If not supplied, then the standard data "
"directories for this KDE session will be searched instead."
msgstr "প্যাকেজ root-র সুনির্দিষ্ট পাথ। পাথের তথ্য উপলব্ধ না করা হলে, বর্তমান KDE সেশানের ক্ষেত্রে প্রযোজ্য প্রমিত ডিরেক্টরির মধ্যে তথ্য খোঁজা হবে।"

#: main.cpp:92
msgid "plasmoid"
msgstr "plasmoid (প্লাসময়েড)"

#: main.cpp:95
msgid "theme"
msgstr "থিম"

#: main.cpp:97
msgid "wallpaper"
msgstr "ওয়াল-পেপার"

#: main.cpp:99
msgid "dataengine"
msgstr "dataengine (ডাটা-ইঞ্জিন)"

#: main.cpp:102
msgid "runner"
msgstr "runner (রানার)"

#: main.cpp:113
msgid "Could not find a suitable installer for package of type"
msgstr "এই ধরনের প্যাকেজের জন্য উপযুক্ত ইনস্টলার পাওয়া যায়নি"

#: main.cpp:121
#, kde-format
msgid "Could not load installer for package of type %1. Error reported was: %2"
msgstr "%1 ধরনের প্যাকেজের জন্য ইনস্টলার লোড করা যায়নি। উল্লিখিত ত্রুটি: %2"

#: main.cpp:155
msgid "One of install, remove or list is required."
msgstr "ইনস্টল, অপসারণ বা তালিকার মধ্যে যে কোনো একটা প্রোয়োজন।"

