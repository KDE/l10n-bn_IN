msgstr "কমান্ডের জন্য আর্গুমেন্ট"

#: solid-hardware.cpp:193
msgid "Syntax:"
msgstr "সিন্ট্যক্স:"

#: solid-hardware.cpp:196
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # সিস্টেমে প্রাপ্য হার্ডওয়ার তালিকাভুক্ত করা হবে।\n"
"             # - 'nonportableinfo' অপশন উল্লেখিত থাকলে,ডিভাইসের \n"
"             # বৈশিষ্টাবলী তালিকাভুক্ত করা হবে (সাবধান থাকবেন, এই অবস্থায় বৈশিষ্টগুলির নাম\n"
"             # ব্যাকটএন্ডের উপর নির্ভরশীল),\n"
"             # - 'details' অপশন উল্লেখিত থাকলে, ডিভাইসের ইন্টারফেসগুলি\n"
"             # এবং সংশ্লিষ্ট বৈশিষ্টাবলী একটি প্ল্যাটফর্মে তালিকাভুক্ত করা হবে\n"
"             # নিরপেক্ষ ভাবে\n"
"             # - অন্যথা সুধুমাত্র ডিভাইসের UDI-গুলো তালিকাভুক্ত করা হবে।\n"

#: solid-hardware.cpp:206
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # 'udi' সংঙ্ক্রান্ত ডিভাইসের সমস্ত ইন্টারফেস এবং বৈশিষ্টাবলী প্রর্দশিত হবে\n"
"             # একটি প্ল্যাটফর্মে নিরপেক্ষ ফ্যাশনে।\n"

#: solid-hardware.cpp:210
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # 'udi' সংঙ্ক্রান্ত ডিভাইসের সমস্ত বৈশিষ্টাবলী প্রর্দশিত হবে "
"             # (সাবধান থাকবেন, এই অবস্থায় বৈশিষ্টগুলির নাম ব্যাকটএন্ডের উপর নির্ভরশীল)।\n"

#: solid-hardware.cpp:214
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""
"             # 'predicate' সংঙ্ক্রান্ত ডিভাইসের UDI তালিকাভুক্ত করুন।\n"
"             # - 'parentUdi' উল্লেখিত থাকলে অনুসন্ধান নিয়ন্ত্রিত থাকবে\n"
"             # সংশ্লিষ্ট ডিভাইসের সাখায়,\n"
"              # - অনথ্যা সমস্ত ডিভাইসেই অনুসন্ধান করা হবে।\n"

#: solid-hardware.cpp:220
msgid "             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr "             #  যদি প্রযোজ্য হয়, সংশ্লিষ্ট 'udi'-এর জন্য ডিভাইসটি মাউন্ট করা হবে।\n"

#: solid-hardware.cpp:223
msgid "             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr "             # প্রযোজ্য হলে, সংশ্লিষ্ট 'udi'-এর জন্য ডিভাইসটি আনমাউন্ট করা হবে।\n"

#: solid-hardware.cpp:226
msgid "             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr "             # প্রযোজ্য হলে, সংশ্লিষ্ট 'udi'-এর জন্য ডিভাইসটি বের করা হবে\n"

#: solid-hardware.cpp:297
