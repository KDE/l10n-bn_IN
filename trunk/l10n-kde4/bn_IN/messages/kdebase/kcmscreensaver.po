msgstr "সম্পূর্ণ পর্দা জুড়ে স্ক্রিন-সেভারের প্রাকপ্রদর্শন করুন"

#: scrnsave.cpp:162
msgid "Settings"
msgstr "মান"

#: scrnsave.cpp:167
msgid "Start a&utomatically"
msgstr "স্বয়ংক্রিয় ভাবে আরম্ভ করা হবে (&u)"

#: scrnsave.cpp:170
msgid "Automatically start the screen saver after a period of inactivity."
msgstr "কিছুক্ষণ নিষ্ক্রিয়তার পরে স্ক্রিন-সেভার স্বয়ংক্রিয় ভাবে চালু করা হবে।"

#: scrnsave.cpp:178 scrnsave.cpp:211
