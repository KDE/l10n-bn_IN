#: kquitapp.cpp:31
msgid "Aaron J. Seigo"
msgstr "অ্যারোন জে. সিয়েগো"

#: kquitapp.cpp:31
msgid "Current maintainer"
msgstr "বর্তমান মেইটেইনার"

#: kquitapp.cpp:35
msgid "Full service name, overrides application name provided"
msgstr ""
"পরিসেবার সম্পূর্ণ নাম। এর সাহায্যে অ্যাপ্লিকেশন দ্বারা উপলব্ধ নাম উপেক্ষা করা হয়"

#: kquitapp.cpp:36
msgid "Path in the D-Bus interface to use"
msgstr "D-Bus ইন্টারফেসের মধ্যে ব্যবহারযোগ্য পাথ"

#: kquitapp.cpp:37
msgid "The name of the application to quit"
msgstr "যে অ্যাপ্লিকেশন থেকে প্রস্থান করা হবে"

