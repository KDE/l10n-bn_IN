#: solid-powermanagement.cpp:49
msgid "solid-powermanagement"
msgstr "solid-powermanagement"

#: solid-powermanagement.cpp:51
msgid ""
"KDE tool for querying and controlling your power management options from the "
"command line"
msgstr ""
"কমান্ড লাইন থেকে পাওয়ার ম্যানেজমেন্ট অপশন গুলো অনুসন্ধান এবং নিয়ন্ত্রণের জন্য KDE-র সরঞ্জাম"

#: solid-powermanagement.cpp:163
msgid "Syntax Error: Not enough arguments"
msgstr "সিন্ট্যক্সে ত্রুটি: যথেষ্ট আরগুমেন্টস নেই"

#: solid-powermanagement.cpp:169
msgid "Syntax Error: Too many arguments"
msgstr "সিন্ট্যক্সে ত্রুটি: অতিরিক্ত আর্গুমেন্টস"

#: solid-powermanagement.cpp:181
msgid "Show available commands"
msgstr "প্রাপ্য কমান্ডস প্রদর্শিত হবে"

#: solid-powermanagement.cpp:183
msgid "Command (see --commands)"
msgstr "কমান্ড (--কমান্ডস দেখুন)"

#: solid-powermanagement.cpp:185
msgid "Arguments for command"
msgstr "কমান্ডের জন্য আর্গুমেন্টস"

#: solid-powermanagement.cpp:197
msgid "Syntax:"
msgstr "সিন্ট্যক্স:"

#: solid-powermanagement.cpp:200
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # method supported by the system\n"
"             # - If the 'scheme' option is specified, give the list of\n"
"             # supported power management schemes by this system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policy\n"
msgstr ""
"             # পাওয়ার ম্যানেজমেন্ট সংঙ্ক্রান্ত নির্দিষ্ট পরিচিতির সমষ্টি তালিকাভুক্ত করা হবে।\n"
"             # - যদি 'সাসপেন্ড' অপশন উল্লেখিত থাকে, সাসপেন্ডের সিস্টেম দ্বারা সমর্থিত পন্থা\n"
"             # তালিকাভুক্ত করা হবে\n"
"             # - যদি 'স্কিম' অপশন উল্লেখিত থাকে, সিস্টেম দ্বারা সমর্থিত পাওয়ার\n"
"             # ম্যানেজমেন্ট স্কিম গুলো তালিকাভুক্ত করা হবে\n"
"             # - যদি 'cpufreq' অপশন উল্লেখিত থাকে, সমর্থিত CPU ফ্রিকয়েন্সি পলিসি\n"
"             # গুলো তালিকাভুক্ত করা হবে\n"

#: solid-powermanagement.cpp:209
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'scheme' option is specified, the power management\n"
"             # scheme set corresponds to 'value'\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # আপনার সিস্টেমে পাওয়ার ম্যানেজমেন্ট অপশনগুলো নিযুক্ত করুন।\n"
"             # - যদি 'স্কিম' অপশন উল্লেখিত থাকে, তবে পাওয়ার ম্যানেজমেন্ট\n"
"             # স্কিম 'value'-তে নির্ধারিত হয়\n"
"             # - যদি 'cpufreq' অপশন উল্লেখিত থাকে তবে CPU ফ্রিকয়েন্সি পলিসি\n"
"             # 'value'-তে নির্ধারিত হয়\n"

#: solid-powermanagement.cpp:216
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             #সংশ্লিষ্ট পদ্ধতির সাহায্যে আপনার কম্পিউটার নিলম্বন করুন।\n"

#: solid-powermanagement.cpp:219
msgid ""
"             # Set and get brightness options of the system.\n"
"             # - If the 'set' option is specified, the brightness is\n"
"             # set to 'value' (as a percentage)\n"
"             # - If the 'get' option is specified, the current brightness\n"
"             # is returned (as a percentage)'\n"
msgstr ""
"             # আপনার সিস্টেমের ঔজ্জ্বল্লের অপসন গুলো নিযুক্ত করে গ্রহন করুন।\n"
"             # - যদি 'সেট' অপশন উল্লেখিত থাকে, তবে ঔজ্জ্বল্লের মান\n"
"             # 'value'-তে (শতকরা হিসেবে) নির্ধারিত হয়\n"
"             # - যদি 'গেট' অপশন উল্লেখিত থাকে, তবে বর্তমান ঔজ্জ্বল্লের মান\n"
"             # পাওয়া যায় (শতকরা হিসেবে)\n"

