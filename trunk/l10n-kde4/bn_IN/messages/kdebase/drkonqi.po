msgstr "ব্যবহারযোগ্য বাগ ঠিকানা"

#: main.cpp:75
msgid "Translated name of the program"
msgstr "প্রোগ্রামের অনুবাদিত নাম"

#: main.cpp:76
msgid "The PID of the program"
msgstr "প্রোগ্রামের PID"

#: main.cpp:77
