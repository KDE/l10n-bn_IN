msgid "Include Backtrace"
msgstr "ব্যাক-ট্রেস অন্তর্ভুক্ত করুন"

#: toplevel.cpp:174
msgid "Generate"
msgstr "উৎপন্ন করা হবে"

#: toplevel.cpp:174
msgid "Do Not Generate"
msgstr "উৎপন্ন করা হবে না"

