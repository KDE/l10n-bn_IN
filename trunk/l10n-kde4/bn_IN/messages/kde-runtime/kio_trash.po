#, kde-format
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""

#: trashimpl.cpp:1266
#, kde-format
msgid "The file is too large to be trashed."
msgstr "ফাইলটির অত্যাধিক বৃহৎ মাপের ফলে আবর্জনার বাক্সে স্থানান্তর করা সম্ভব নয়।"

