#: audio_plugin.cpp:74
#, kde-format
msgid "An older file named '%1' already exists.\n"
msgstr "'%1' নামক একটি পুরোনো ফাইল বর্তমানে উপস্থিত রয়েছে।\n"

#: audio_plugin.cpp:76
#, kde-format
msgid "A similar file named '%1' already exists.\n"
msgstr "'%1' নামক একটি অনুরূপ ফাইল বর্তমানে উপস্থিত রয়েছে।\n"

#: audio_plugin.cpp:78
#, kde-format
msgid "A newer file named '%1' already exists.\n"
msgstr "'%1' নামক একটি নতুন ফাইল বর্তমানে উপস্থিত রয়েছে।\n"

#: audio_plugin.cpp:80
msgid "Source File"
msgstr "উৎস ফাইল"

#: audio_plugin.cpp:81
msgid "Existing File"
msgstr "উপস্থিত ফাইল"

#: audio_plugin.cpp:82
msgid "Would you like to replace the existing file with the one on the right?"
msgstr "উপস্থিত ফাইলটির পরিবর্তে ডানদিকে প্রদর্শিত ফাইলটি প্রতিস্থাপন করা হবে কি?"

#: audiopreview.cpp:51
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"এই অডিও ফাইলটি স্থানীয়\n"
"হোস্ট সিস্টেমে সংরক্ষিত নয়।\n"
"এই লেবেলে ক্লিক করে এটি লোড করুন।\n"

#: audiopreview.cpp:57
msgid "Unable to load audio file"
msgstr "অডিও ফাইল লোড করতে ব্যর্থ"

