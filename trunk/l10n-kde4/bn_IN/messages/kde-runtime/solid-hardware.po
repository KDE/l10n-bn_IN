#: solid-hardware.cpp:211
msgid "Syntax:"
msgstr "সিন্ট্যাক্স:"

# runab: modified the string with the 'details' option, সুধুমাত্র=>শুধুমাত্র
#: solid-hardware.cpp:214
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # সিস্টেমে উপলব্ধ হার্ডওয়ার তালিকাভুক্ত করা হবে।\n"
"             # - 'nonportableinfo' অপশন উল্লিখিত থাকলে,ডিভাইসের \n"
"             # বৈশিষ্টাবলী তালিকাভুক্ত করা হবে (সাবধান থাকবেন, এই অবস্থায় "
"বৈশিষ্টগুলির নাম\n"
"             # ব্যাক-এন্ডের উপর নির্ভরশীল),\n"
"             # - 'details' অপশন উল্লিখিত থাকলে, ডিভাইসের ইন্টারফেসগুলি\n"
"             # এবং সংশ্লিষ্ট বৈশিষ্ট্যাবলীগুলি প্ল্যাটফর্ম নির্বিশেষ একটি বিন্যাসে \n"
"             # তালিকাভুক্ত করা হবে\n"
"             # - অন্যথা শুধুমাত্র ডিভাইসের UDI-গুলি তালিকাভুক্ত করা হবে।\n"

# runab: corrected the spelling of সংক্রান্ত (সংঙ্ক্রান্ত = wrong)
#: solid-hardware.cpp:224
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # 'udi' সংক্রান্ত ডিভাইসের সমস্ত ইন্টারফেস এবং বৈশিষ্টাবলী প্ল্যাটফর্ম "
"নির্বিশেষ\n"
"             # একটি বিন্যাসে প্রর্দশিত হবে।\n"

# runab: corrected the spelling of সংক্রান্ত (সংঙ্ক্রান্ত = wrong),ব্যাক-এন্ড (ব্যাকটএন্ডের=wrong), বৈশিষ্ট্যাবলী (বৈশিষ্টগুলি =wrong)
#: solid-hardware.cpp:228
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # 'udi' সংক্রান্ত ডিভাইসের সমস্ত বৈশিষ্ট্যাবলী প্রর্দশিত "
"হবে              # (সাবধান থাকবেন, এই অবস্থায় বৈশিষ্টগুলির নাম ব্যাক-এন্ডের উপর "
"নির্ভরশীল)।\n"

# runab: corrected typo in অনথ্যা
#: solid-hardware.cpp:232
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""
"             # 'predicate' সংঙ্ক্রান্ত ডিভাইসের UDI তালিকাভুক্ত করুন।\n"
"             # - 'parentUdi' উল্লিখিত থাকলে অনুসন্ধান সংশ্লিষ্ট ডিভাইসের \n"
"             # সাখা অবধি সীমিত থাকবে,\n"
"              # - অন্যথা সমস্ত ডিভাইসেই অনুসন্ধান করা হবে।\n"

#: solid-hardware.cpp:238
msgid ""
"             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr ""
"             #  যদি প্রযোজ্য হয়, সংশ্লিষ্ট 'udi'-এর জন্য ডিভাইসটি মাউন্ট করা হবে।\n"

#: solid-hardware.cpp:241
msgid ""
"             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr ""
"             # প্রযোজ্য হলে, সংশ্লিষ্ট 'udi'-এর জন্য ডিভাইসটি আন-মাউন্ট করা হবে।\n"

#: solid-hardware.cpp:244
msgid ""
"             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr "             # প্রযোজ্য হলে, সংশ্লিষ্ট 'udi'-এর জন্য ডিভাইসটি বের করা হবে\n"

