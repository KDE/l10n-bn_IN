#: main.cpp:44
#, kde-format
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - দূরবর্তী ফাইল প্রদর্শন, পরিবর্তন নিরীক্ষণ ও আপলোড অনুরোধের জন্য ব্যবহৃত হয়"

#: main.cpp:52
#, kde-format
msgid "'command' expected.\n"
msgstr "'command' প্রত্যাশিত।\n"

#: main.cpp:81
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"সঠিক নয়"

#: main.cpp:83
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"দূরবর্তী URL %1\n"
"--tempfiles সুইচের সাথে ব্যবহার করা যাবে না"

#: main.cpp:216
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"অস্থায়ী ফাইল রূপে চিহ্নিত\n"
"%1\n"
"পরিবর্তন করা হয়েছে।\n"
"আপনি কি এটি মুছে ফেলতে ইচ্ছুক?"

#: main.cpp:217 main.cpp:224
#, kde-format
msgid "File Changed"
msgstr "ফাইল পরিবর্তিত হয়েছে"

#: main.cpp:217
#, kde-format
msgid "Do Not Delete"
msgstr "মুছে ফেলা হবে না"

#: main.cpp:223
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"ফাইল\n"
"%1\n"
"পরিবর্তন করা হয়েছে।\n"
"পরিবর্তনগুলি আপলোড করা হবে কি?"

#: main.cpp:224
#, kde-format
msgid "Upload"
msgstr "আপলোড করা হবে"

#: main.cpp:224
#, kde-format
msgid "Do Not Upload"
msgstr "আপলোড করা হবে না"

