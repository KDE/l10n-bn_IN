#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:36
msgctxt "Name"
msgid "Data tools"
msgstr "তথ্য সংক্রান্ত সামগ্রী"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:91
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
