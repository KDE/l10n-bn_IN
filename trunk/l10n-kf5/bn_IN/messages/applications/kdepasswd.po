msgctxt "@title:window"
msgid "Change Password"
msgstr "পাসওয়ার্ড পরিবর্তন করুন"

#: passwddlg.cpp:35
msgid "Please enter your current password:"
msgstr "অনুগ্রহ করে বর্তমান পাসওয়ার্ড লিখুন:"

#: passwddlg.cpp:55 passwddlg.cpp:182
msgid "Conversation with 'passwd' failed."
msgstr "'passwd'-র সাথে যোগাযোগ করতে ব্যর্থ।"

#: passwddlg.cpp:65
msgid "Could not find the program 'passwd'."
msgstr "'passwd' প্রোগ্রাম পাওয়া যায়নি।"

#: passwddlg.cpp:70
msgid "Incorrect password. Please try again."
msgstr "পাসওয়ার্ড সঠিক নয়। অনুগ্রহ করে পুনরায় প্রচেষ্টা করুন।"

#: passwddlg.cpp:74
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr "অভ্যন্তরীণ ত্রুটি: PasswdProcess::checkCurrent থেকে প্রাপ্ত মান বৈধ নয়।"

#: passwddlg.cpp:103
msgid "Please enter your new password:"
msgstr "অনুগ্রহ করে নতুন পাসওয়ার্ড লিখুন:"

#: passwddlg.cpp:105
#, kde-format
msgid "Please enter the new password for user <b>%1</b>:"
msgstr "অনুগ্রহ করে, <b>%1</b> ব্যবহারকারী জন্য নতুন পাসওয়ার্ড লিখুন:"

#: passwddlg.cpp:129
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""

#: passwddlg.cpp:132
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""

