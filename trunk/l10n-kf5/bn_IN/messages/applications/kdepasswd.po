msgid "Password Too Long"
msgstr "পাসওয়ার্ড অত্যাধিক লম্বা"

#: passwddlg.cpp:137
msgid "Truncate"
msgstr "ছোট করুন"

#: passwddlg.cpp:138
msgid "Use as Is"
msgstr "এটি ব্যবহার করা হবে"

