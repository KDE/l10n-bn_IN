msgid ""
"  kioclient copy 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kioclient copy 'src' 'dest'\n"
"            # URL 'src'-কে 'dest'-এ কপি করা হয়।\n"
"            #   'src'-র ক্ষেত্রে একাধিক URL উল্লিখিত হতে পারে।\n"
"\n"

