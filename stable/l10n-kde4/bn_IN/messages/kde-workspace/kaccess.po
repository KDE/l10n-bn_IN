#: kaccess.cpp:694
#, kde-format
msgid "Do you really want to deactivate \"%1\"?"
msgstr "আপনি কি নিশ্চিতরূপে \"%1\" নিষ্ক্রিয় করতে ইচ্ছুক?"

#: kaccess.cpp:697
#, kde-format
msgid "Do you really want to deactivate \"%1\" and \"%2\"?"
msgstr "আপনি কি নিশ্চিতরূপে \"%1\" ও \"%2\" নিষ্ক্রিয় করতে ইচ্ছুক?"

#: kaccess.cpp:700
#, kde-format
msgid "Do you really want to deactivate \"%1\", \"%2\" and \"%3\"?"
msgstr "আপনি কি নিশ্চিতরূপে \"%1\", \"%2\" ও \"%3\" নিষ্ক্রিয় করতে ইচ্ছুক?"

#: kaccess.cpp:704
#, kde-format
msgid "Do you really want to deactivate \"%1\", \"%2\", \"%3\" and \"%4\"?"
msgstr "আপনি কি নিশ্চিতরূপে \"%1\", \"%2\", \"%3\" ও \"%4\"নিষ্ক্রিয় করতে ইচ্ছুক?"

