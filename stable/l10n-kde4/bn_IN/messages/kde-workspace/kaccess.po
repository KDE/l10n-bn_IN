#, kde-format
msgid "Do you really want to activate \"%1\"?"
msgstr "আপনি কি নিশ্চিতরূপে \"%1\" সক্রিয় করতে ইচ্ছুক?"

#: kaccess.cpp:714
#, kde-format
msgid "Do you really want to activate \"%1\" and to deactivate \"%2\"?"
msgstr "আপনি কি নিশ্চিতরূপে \"%1\" সক্রিয় ও \"%2\" নিষ্ক্রিয় করতে ইচ্ছুক?"

#: kaccess.cpp:717
#, kde-format
msgid ""
"Do you really want to activate \"%1\" and to deactivate \"%2\" and \"%3\"?"
