#: kio_floppy.cpp:198
#, kde-format
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"%1 ড্রাইভ ব্যবহার করতে ব্যর্থ।\n"
"ড্রাইভ এই মুহূর্তে ব্যস্ত।\n"
"কর্ম সমাপ্ত হওয়ার অপেক্ষা করুন ও পুনরায় প্রচেষ্টা করুন।"

#: kio_floppy.cpp:202 kio_floppy.cpp:1116
#, kde-format
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"%1 ফাইলে লিখতে ব্যর্থ।\n"
"%2 ড্রাইভের ডিস্ক সম্ভবত পূর্ণ হয়ে গেছে।"

#: kio_floppy.cpp:212
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"%1 ব্যবহার করতে ব্যর্থ।\n"
"%2 ড্রাইভের মধ্যে সম্ভবত কোনো ডিস্ক উপস্থিত নেই।"

#: kio_floppy.cpp:216
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough "
"permissions to access the drive."
msgstr ""
"%1 ব্যবহার করতে ব্যর্থ।\n"
"%2 ড্রাইভের মধ্যে সম্ভবত কোনো ডিস্ক উপস্থিত নেই অথবা এই ড্রাইভ ব্যবহারের জন্য "
"প্রয়োজনীয় অনুমতি আপনার নেই।"

#: kio_floppy.cpp:220
#, kde-format
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"%1 ব্যবহার করতে ব্যর্থ।\n"
"%2 ড্রাইভ সমর্থিত নয়।"

#: kio_floppy.cpp:225
#, kde-format
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"%1 ব্যবহার করতে ব্যর্থ।\n"
"অনুগ্রহ করে পরীক্ষা করুন %2 ড্রাইভের মধ্যে উপস্থিত ফ্লপিটি DOS-ফরম্যাটের কি না \n"
"এবং ডিভাইস ফাইলের (উদাহরণ, /dev/fd0) অনুমতি সঠিরূপে নির্ধারিত হয়েছে কি না "
"(উদাহরণস্বরূপ, rwxrwxrwx)।"

#: kio_floppy.cpp:229
#, kde-format
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"%1 ব্যবহার করতে ব্যর্থ।\n"
"%2 ড্রাইভের মধ্যে উপস্থিত ডিস্কটি সম্ভবত DOS-ফরম্যাটের ফ্লপি ডিস্ক নয়।"

#: kio_floppy.cpp:233
#, kde-format
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"অনুমতি প্রত্যাখ্যিত।\n"
"%1-এ লিখতে ব্যর্থ।\n"
"%2 ড্রাইভের ডিস্কটি সম্ভবত লেখার জন্য অনুমোদিত নয়।"

#: kio_floppy.cpp:242
#, kde-format
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"%1-র বুট-সেক্টর থেকে পড়তে ব্যর্থ।\n"
"সম্ভবত %2 ড্রাইভের মধ্যে কোনো ডিস্ক উপস্থিত নেই।"

#: kio_floppy.cpp:365
#, kde-format
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"\"%1\" প্রোগ্রাম আরম্ভ করতে ব্যর্থ।\n"
"অনুগ্রহ করে পরীক্ষা করুন, সিস্টেমের মধ্যে mtools প্যাকেজটি সঠিকরূপে ইনস্টল করা হয়েছে "
"কি না।"
