#: kwriteconfig.cpp:35
#, kde-format
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:37
#, kde-format
msgid "Write KConfig entries - for use in shell scripts"
msgstr "KConfig এনট্রি লিখুন - শেল স্ক্রিপ্টের সাথে ব্যবহারের উদ্দেশ্যে"

#: kwriteconfig.cpp:39
#, kde-format
msgid "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"
msgstr "(c) ২০০১ Red Hat, Inc. ও লুই পেদ্রো কোয়লহো"

#: kwriteconfig.cpp:40
#, kde-format
msgid "Luís Pedro Coelho"
msgstr "লুই পেদ্রো কোয়েলহো"

#: kwriteconfig.cpp:41
#, kde-format
msgid "Bernhard Rosenkraenzer"
msgstr "বার্নার্ড রোসেনক্রেইনজার"

#: kwriteconfig.cpp:41
#, kde-format
msgid "Wrote kreadconfig on which this is based"
msgstr ""
"kreadconfig-র লেখক। এই প্রোগ্রাম kreadconfig-র উপর ভিত্তি করে নির্মিত হয়েছে।"

#: kwriteconfig.cpp:47
#, kde-format
msgid "Use <file> instead of global config"
msgstr "গ্লোবাল কনফিগের পরিবর্তে <file> ব্যবহার করুন"

#: kwriteconfig.cpp:48
#, kde-format
msgid "Group to look in. Use repeatedly for nested groups."
msgstr "যে দলের মধ্যে অনুসন্ধান করা হবে। নেস্টেড দলের জন্য পুনাবৃত্তি করা আবশ্যক।"

#: kwriteconfig.cpp:49
#, kde-format
msgid "Key to look for"
msgstr "অনুসন্ধানের জন্য চিহ্নিত কি"

#: kwriteconfig.cpp:50
#, kde-format
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"ভেরিয়েবলের ধরন। বুলিয়ানের ক্ষেত্রে \"bool\" ব্যবহার করুন, অন্যথা সেটি স্ট্রিং রূপে "
"ব্যবহার করা হবে।"

#: kwriteconfig.cpp:51
#, kde-format
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr ""
"লেখার উদ্দেশ্যে চিহ্নিত মান। উল্লেখ করা আবশ্যক। ফাঁকা হলে শেলের মধ্যে '' লিখুন।"
