#: rc.cpp:152
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Process can only use the "
"hard disk when no other process has used it very recently.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">সম্প্রতি অন্য কোনো প্রসেস "
"দ্বারা হার্ড-ডিস্ক ব্যবহার না করা হলে প্রসেস দ্বারা এটি ব্যবহার করা যাবে।</p></"
"body></html>"

#. i18n: file: ReniceDlgUi.ui:273
#. i18n: ectx: property (whatsThis), widget (QRadioButton, radioIdle)
#: rc.cpp:158
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Idle Scheduling</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">A  program running with "
"<span style=\" font-weight:600;\">Idle</span> I/O priority will only get "
"disk time when no other program has asked for disk I/O for a defined grace "
"period. The impact of <span style=\" font-weight:600;\">Idle</span> I/O "
"processes on normal system activity should be zero. Priority is not "
"applicable to this scheduling class.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">কর্মবিহীন সিডিউলিং</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"> <span style=\" font-"
"weight:600;\">কর্মবিহীন</span> ইনপুট/আউটপুট গুরুত্বসহ চলমান প্রোগ্রামের ক্ষেত্রে, "
"সুনির্দিষ্ট গ্রেস সময় অবধি অন্য কোনো প্রোগ্রাম দ্বারা ডিস্কে ইনপুট/আউটপুটের অনুরোধ না "
"করা হলে ডিস্ক ব্যবহারের অনুমতি প্রদান করা হবে। সিস্টেমের সাধারণ কর্মের উপর <span "
"style=\" font-weight:600;\">কর্মবিহীন</span> ইনপুট/আউটপুট প্রসেস দ্বারা কোনো "
"প্রভাব সৃষ্টি করা হবে না। এই শ্রেণীর সিডিউল ব্যবস্থার ক্ষেত্রে গুরুত্ব ধার্য করা হয় না।</"
"p></body></html>"

#. i18n: file: ReniceDlgUi.ui:276
#. i18n: ectx: property (text), widget (QRadioButton, radioIdle)
#: rc.cpp:165
msgid "Idle"
msgstr "কর্মবিহীন"

#. i18n: file: ReniceDlgUi.ui:286
#. i18n: ectx: property (toolTip), widget (QRadioButton, radioBestEffort)
#: rc.cpp:168
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Process is given higher "
"priority to access the hard disk than Normal.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Normal (সাধারণ) প্রসেসের "
"তুলনায় প্রসেসকে অধিক গুরুত্ব দেওয়া হয়।</p></body></html>"

#. i18n: file: ReniceDlgUi.ui:293
#. i18n: ectx: property (whatsThis), widget (QRadioButton, radioBestEffort)
#: rc.cpp:174
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Best Effort Scheduling</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Processes with a higher "
"priority will take priority for access to the hard disk.  Programs running "
"at the same <span style=\" font-weight:600;\">Best Effort/Normal</span> "
"priority are served in a <span style=\" font-weight:600;\">Round Robin</"
"span> fashion.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">সর্বোত্তম ক্ষমতার সিডিউলিং</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">অধিক গুরুত্বপ্রাপ্ত প্রসেসগুলি "
"হার্ড-ডিস্ক ব্যবহারের অগ্রাধিকার পাবে।  একই <span style=\" font-weight:600;"
"\">সর্বোত্তম ক্ষমতা/Normal (সাধারণ)</span> গুরুত্বে চলমান প্রোগ্রামগুলি <span style="
"\" font-weight:600;\">রাউন্ড রবিন</span> পদ্ধতিতে পরিচালিত হবে।</p></body></"
"html>"

#. i18n: file: ReniceDlgUi.ui:296
#. i18n: ectx: property (text), widget (QRadioButton, radioBestEffort)
#: rc.cpp:181
msgid "Best Effort"
msgstr "সর্বোত্তম ক্ষমতা"

#. i18n: file: ReniceDlgUi.ui:306
#. i18n: ectx: property (toolTip), widget (QRadioButton, radioRealTime)
#: rc.cpp:184
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Process gets immediate "
"access to the hard disk whenever needed, regardless of what else is going on."
"</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">অন্যান্য চলমান কার্জ "
"নির্বিশেষে, প্রসেসটির প্রয়োজন অনুসারে তৎক্ষনাৎ হার্ড-ডিস্ক ব্যবহারের অনুমতি প্রদান করা "
"হবে।</p></body></html>"

#. i18n: file: ReniceDlgUi.ui:313
#. i18n: ectx: property (whatsThis), widget (QRadioButton, radioRealTime)
#: rc.cpp:190
#, fuzzy
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Real Time Scheduling</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">The <span style=\" font-"
"weight:600;\">Real Time</span> scheduling class is given first access to the "
"disk, regardless of what else is going on in the system. Thus the <span "
"style=\" font-weight:600;\">Real Time</span> class needs to be used with "
"some care,  as  it  can  starve other processes. As with the <span style=\" "
"font-weight:600;\">Best Effort</span> class, 8 priority levels are defined "
"denoting how big a time slice a given process will receive on each "
"scheduling window</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">রিয়েল টাইম সিডিউলিং</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">এই <span style=\" font-"
"weight:600;\">রিয়েল টাইম</span> সিডিউলিং-কে ডিস্কে প্রথম access করতে দেওয়া হয়, "
"regardless of অন্য যা কিছু সিস্টেমে চলছে। তাই এই <span style=\" font-weight:600;"
"\">রিয়েল টাইম</span> ক্লাসটি সামান্য যত্নের সাথে ব্যবহার করা উচিৎ,  কারণ  এটি  "
"অন্যান্য প্রসেসগুলিকে  starve করাতে পারে। <span style=\" font-weight:600;\">বেস্ট "
"এফোর্ট</span> ক্লাসের সাথে, ৮-টি প্রওরিটি লেভেল উল্লেখকৃত রয়েছে যা ব্যাখ্যা করে "
"প্রতিটি সিডিউলিং উইনডোতে সংশ্লিষ্ট প্রসেসটি কত বড় টাইম স্লাইস পাবে</p></body></"
"html>"

#. i18n: file: ReniceDlgUi.ui:316
#. i18n: ectx: property (text), widget (QRadioButton, radioRealTime)
#: rc.cpp:197
msgid "Real Time"
msgstr "রিযেল টাইম"

