msgstr "(c) ২০০৩ ওয়াল্ডো ব্যাস্টিয়ান"

#: kde-menu.cpp:114
msgid "Waldo Bastian"
msgstr "ওয়াল্ডো ব্যাস্টিয়ান"

#: kde-menu.cpp:114
msgid "Author"
msgstr "নির্মাতা"

#: kde-menu.cpp:119
msgid "Output data in UTF-8 instead of local encoding"
msgstr "স্থানীয় এনকোডিংয়ের পরিবর্তে UTF-8 বিন্যাসে তথ্য আউটপুট করা হবে"

#: kde-menu.cpp:120
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr ""
"অ্যাপ্লিকেশনের নাম ধারণকারী মেনুর menu-id\n"
"প্রদর্শন করা হবে"

#: kde-menu.cpp:121
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr ""
"অ্যাপ্লিকেশনের নাম ধারণকারী মেনুর নাম (শিরোনাম)\n"
"প্রদর্শন করা হবে"

#: kde-menu.cpp:122
msgid "Highlight the entry in the menu"
msgstr "মেনুর মধ্যে এনট্রিটি উজ্জ্বল করা হবে"

#: kde-menu.cpp:123
msgid "Do not check if sycoca database is up to date"
msgstr "sycoca ডাটাবেস আপ-টু-ডেট করা আছে কি না পরীক্ষা করা হবে না"

#: kde-menu.cpp:124
msgid "The id of the menu entry to locate"
msgstr "সনাক্ত করার উদ্দেশ্যে মেনুর এনট্রির id"

#: kde-menu.cpp:133
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr "একটি application-id যেমন 'kde4-konsole.desktop' উল্লেখ করা আবশ্যক"

#: kde-menu.cpp:142
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr "--print-menu-id, --print-menu-name অথবা --highlight-র মধ্যে অন্তত একটি উল্লেখ করা আবশ্যক"

#: kde-menu.cpp:164
#, kde-format
msgid "No menu item '%1'."
msgstr "মেনুর মধ্যে '%1' বস্তুটি অনুপস্থিত।"

#: kde-menu.cpp:168
#, kde-format
msgid "Menu item '%1' not found in menu."
msgstr "মেনুর মধ্যে '%1' বস্তুটি পাওয়া যায়নি।"

