msgstr "সিন্ট্যাক্স:"

# runab: changes suspend and scheme to english as these are options
#: solid-powermanagement.cpp:200
#, fuzzy
#| msgid ""
#| "             # List a particular set of information regarding power "
#| "management.\n"
#| "             # - If the 'suspend' option is specified, give the list of "
#| "suspend\n"
#| "             # method supported by the system\n"
#| "             # - If the 'scheme' option is specified, give the list of\n"
#| "             # supported power management schemes by this system\n"
#| "             # - If the 'cpufreq' option is specified, give the list of\n"
#| "             # supported CPU frequency policy\n"
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # methods supported by the system\n"
"             # - If the 'scheme' option is specified, give the list of\n"
"             # power management schemes supported by this system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policies\n"
msgstr ""
"             # পাওয়ার ম্যানেজমেন্ট সংঙ্ক্রান্ত নির্দিষ্ট পরিচিতির সমষ্টি তালিকাভুক্ত "
"করা হবে।\n"
"             # - যদি 'suspend' অপশন উল্লেখিত থাকে, সাসপেন্ডের সিস্টেম দ্বারা "
"সমর্থিত পন্থা\n"
"             # তালিকাভুক্ত করা হবে\n"
"             # - যদি 'scheme' অপশন উল্লেখিত থাকে, সিস্টেম দ্বারা সমর্থিত পাওয়ার\n"
"             # ম্যানেজমেন্ট স্কিম গুলো তালিকাভুক্ত করা হবে\n"
"             # - যদি 'cpufreq' অপশন উল্লেখিত থাকে, সমর্থিত CPU ফ্রিকয়েন্সি "
"পলিসি\n"
"             # গুলো তালিকাভুক্ত করা হবে\n"

# runab: changes scheme to english it is an option
#: solid-powermanagement.cpp:209
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'scheme' option is specified, the power management\n"
"             # scheme set corresponds to 'value'\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # আপনার সিস্টেমে পাওয়ার ম্যানেজমেন্ট অপশনগুলো নিযুক্ত করুন।\n"
"             # - যদি 'scheme' অপশন উল্লেখিত থাকে, তবে পাওয়ার ম্যানেজমেন্ট\n"
"             # স্কিম 'value'-তে নির্ধারিত হয়\n"
"             # - যদি 'cpufreq' অপশন উল্লেখিত থাকে তবে CPU ফ্রিকয়েন্সি পলিসি\n"
"             # 'value'-তে নির্ধারিত হয়\n"

# runab: A space inserted afte the #
#: solid-powermanagement.cpp:216
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # সংশ্লিষ্ট পদ্ধতির সাহায্যে আপনার কম্পিউটার নিলম্বন করুন।\n"

# runab: changed set and get to english it is an option. corrected the spelling of ঔজ্জ্বল্য
#: solid-powermanagement.cpp:219
msgid ""
"             # Set and get brightness options of the system.\n"
"             # - If the 'set' option is specified, the brightness is\n"
"             # set to 'value' (as a percentage)\n"
"             # - If the 'get' option is specified, the current brightness\n"
"             # is returned (as a percentage)'\n"
msgstr ""
"             # আপনার সিস্টেমের ঔজ্জ্বল্ল্যের অপসন গুলো নিযুক্ত করে গ্রহন করুন।\n"
"             # - যদি 'set' অপশন উল্লেখিত থাকে, তবে ঔজ্জ্বল্ল্যের মান\n"
"             # 'value'-তে (শতকরা হিসেবে) নির্ধারিত হয়\n"
"             # - যদি 'get' অপশন উল্লেখিত থাকে, তবে বর্তমান ঔজ্জ্বল্ল্যের মান\n"
"             # পাওয়া যায় (শতকরা হিসেবে)\n"

