#: PowerDevilRunner.cpp:49 PowerDevilRunner.cpp:51 PowerDevilRunner.cpp:70
#: PowerDevilRunner.cpp:71 PowerDevilRunner.cpp:186
msgctxt "Note this is a KRunner keyword"
msgid "power profile"
msgstr "বিদ্যুৎ সরবরাহের প্রোফাইল"

#: PowerDevilRunner.cpp:50
msgid "Lists all power profiles and allows them to be activated"
msgstr "বিদ্যুৎ সরবরাহ সংক্রান্ত সকল প্রোফাইলের তালিকা প্রদর্শন করে ও সকল প্রোফাইল সক্রিয় করার সুবিধা উপলব্ধ করে"

#: PowerDevilRunner.cpp:52
msgid "Lists all power saving schemes and allows them to be activated"
msgstr "বিদ্যুৎ সঞ্চয়ের সকল স্কিমের তালিকা প্রদর্শন করে ও সেগুলি সক্রিয় করার সুবিধা উপলব্ধ করে"

#: PowerDevilRunner.cpp:53 PowerDevilRunner.cpp:72 PowerDevilRunner.cpp:301
msgctxt "Note this is a KRunner keyword"
msgid "suspend"
msgstr "স্থগিত"

#: PowerDevilRunner.cpp:54
msgid ""
"Lists system suspend (e.g. sleep, hibernate) options and allows them to be "
"activated"
msgstr "সিস্টেম স্থগিতকরণ (উদাহরণ, নিদ্রিত অবস্থা) সংক্রান্ত বিভিন্ন বিকল্পের তালিকা প্রদর্শন করে ও সেগুলি সক্রিয় করার সুবিধা উপলব্ধ করে"

#: PowerDevilRunner.cpp:57 PowerDevilRunner.cpp:73 PowerDevilRunner.cpp:202
msgctxt "Note this is a KRunner keyword"
msgid "cpu policy"
msgstr "cpu সংক্রান্ত নিয়মনীতি"

#: PowerDevilRunner.cpp:58
msgid "Lists all CPU frequency scaling policies and allows them to be activated"
msgstr "CPU-র ফ্রিকোয়েন্সির মাপ পরিবর্তন সংক্রান্ত সকল নিয়মনীতির তালিকা প্রদর্শন করে ও সেগুলি সক্রিয় করার সুবিধা উপলব্ধ করে"

#: PowerDevilRunner.cpp:59 PowerDevilRunner.cpp:74 PowerDevilRunner.cpp:203
msgctxt "Note this is a KRunner keyword"
msgid "power governor"
msgstr "power governor"

#: PowerDevilRunner.cpp:62 PowerDevilRunner.cpp:75 PowerDevilRunner.cpp:260
msgctxt "Note this is a KRunner keyword"
msgid "screen brightness"
msgstr "পর্দার উজ্জ্বলতা"

#: PowerDevilRunner.cpp:64
#, no-c-format
msgid ""
"Lists screen brightness options or sets it to the brightness defined by :q:; "
"e.g. screen brightness 50 would dim the screen to 50% maximum brightness"
msgstr ""
"পর্দার উজ্জ্বলতা সংক্রান্ত বিকল্পগুলির তালিকা প্রদর্শন করে অথবা :q: দ্বারা চিহ্নিত উজ্জ্বলতার মাত্রা নির্ধারণ করে; "
"উদাহরণস্বরূপ, পর্দার উজ্জ্বলতার মাত্রা 50 (৫০) নির্ধারিত হলে পর্দার উজ্জ্বলতা সর্বাধিক পরিমাণের ৫০% শতাংশে হ্রাস করা হবে"

#: PowerDevilRunner.cpp:66 PowerDevilRunner.cpp:76 PowerDevilRunner.cpp:261
msgctxt "Note this is a KRunner keyword"
msgid "dim screen"
msgstr "পর্দার উজ্জ্বলতা হ্রাস করা হবে"

#: PowerDevilRunner.cpp:196
#, kde-format
msgid "Set Profile to '%1'"
msgstr "'%1' প্রোফাইল নির্ধারণ করা হবে"

#: PowerDevilRunner.cpp:234
#, kde-format
msgid "Set CPU frequency scaling policy to '%1'"
msgstr "CPU ফ্রিকোয়েন্সির মাপ পরিবর্তনের নিয়মনীতি '%1'-এ নির্ধারণ করা হবে"

#: PowerDevilRunner.cpp:240
msgctxt "Note this is a KRunner keyword"
msgid "power scheme"
msgstr "বিদ্যুৎ সরবরাহ সংক্রান্ত স্কিম"

#: PowerDevilRunner.cpp:253
#, kde-format
msgid "Set Powersaving Scheme to '%1'"
msgstr "বিদ্যুৎ সঞ্চয় সংক্রান্ত স্কিম রূপে '%1' ধার্য করুন"

#: PowerDevilRunner.cpp:270
#, kde-format
msgid "Set Brightness to %1"
msgstr "উজ্জ্বলতার মাত্রা %1 ধার্য করুন"

#: PowerDevilRunner.cpp:280
msgid "Dim screen totally"
msgstr "পর্দার উজ্জ্বলতার মাত্রা সম্পূর্ণরূপে হ্রাস করা হবে"

#: PowerDevilRunner.cpp:288
msgid "Dim screen by half"
msgstr "পর্দার উজ্জ্বলতার মাত্রা অর্ধেক হ্রাস করা হবে"

#: PowerDevilRunner.cpp:296
msgid "Turn off screen"
msgstr "পর্দা বন্ধ করা হবে"

