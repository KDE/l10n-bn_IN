#: kcmxinerama.cpp:55
msgid "kcmxinerama"
msgstr "kcmxinerama"

#: kcmxinerama.cpp:56
msgid "KDE Multiple Monitor Configurator"
msgstr "KDE-র একাধিক মনটির কনফিগারেশন ব্যবস্থা"

#: kcmxinerama.cpp:58
msgid "(c) 2002-2003 George Staikos"
msgstr "(c) ২০০২-২০০২ জর্জ স্টাইকোস"

#: kcmxinerama.cpp:60
msgid "George Staikos"
msgstr "জর্জ স্টাইকোস"

#: kcmxinerama.cpp:63
msgid ""
"<h1>Multiple Monitors</h1> This module allows you to configure KDE support "
"for multiple monitors."
msgstr ""
"<h1>একাধিক মনিটর</h1> এই মডিউলের সাহায্যে KDE-র মধ্যে একাধিক মনিটরের ব্যবহার "
"কনফিগারে করা সম্ভব হবে।"

#: kcmxinerama.cpp:87
#, kde-format
msgid "Display %1"
msgstr "প্রদর্শন %1"

#: kcmxinerama.cpp:105
msgid "Display Containing the Pointer"
msgstr "পয়েন্টার ধারণকারী প্রদর্শন"

#: kcmxinerama.cpp:116
msgid ""
"<qt><p>This module is only for configuring systems with a single desktop "
"spread across multiple monitors. You do not appear to have this "
"configuration.</p></qt>"
msgstr ""

#: kcmxinerama.cpp:180
msgid "Some settings may affect only newly started applications."
msgstr "কিছু বৈশিষ্ট্যের মান, শুধুমাত্র নতুন আরম্ভ করা অ্যাপ্লিকেশনগুলিকে প্রভাবিত করবে।"

#: kcmxinerama.cpp:180
msgid "KDE Multiple Monitors"
msgstr "KDE-র একাধিক মনিটর"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "রুণা ভট্টাচার্য্য"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "runab@redhat.com"

